---
import AppLink from '../../ui/AppLink.astro';
import TextLink from '../../ui/TextLink.astro';
import Heart from '@/components/astro/icons/Heart.astro';

interface Tweet {
  id_str: string;
  text: string;
  created_at: string;
  user: {
    name: string;
    screen_name: string;
    profile_image_shape: string;
    id: string;
    is_blue_verified: boolean;
    verified: boolean;
    verified_type: 'Business' | 'Government';
    profile_image_url_https: string;
  };
  conversation_count: number;
  news_action_type: string;
}

interface Props {
  id: string;
  host?: 'https://www.x.com' | 'https://nitter.net' | 'https://xcancel.com';
}

const { id, host = 'https://xcancel.com' } = Astro.props;

const HostLabelMap = {
  'https://www.x.com': 'X',
  'https://nitter.net': 'Nitter',
  'https://xcancel.com': 'XCancel'
};

const url = new URL('/tweet-result', 'https://cdn.syndication.twimg.com/');
url.searchParams.set('id', id);
url.searchParams.set('token', 'x');

const result = await fetch(url);
const meta = await result.json() as Tweet;

const numberFormatter = new Intl.NumberFormat('en-US', { style: 'decimal', notation: 'compact', compactDisplay: 'short' });

// lacking like info, lacking view,
console.log(meta);
---

<div class="flex flex-col gap-3 mx-auto rounded-lg border border-separator w-full max-w-[550px] p-4">
    <div class="flex items-center gap-2">
        <AppLink title={`View Profile on ${HostLabelMap[host]}`} href={`${host}/${meta.user.screen_name}`}>
          <img src={meta.user.profile_image_url_https} class:list={["hover:brightness-90 transition-all", { 'rounded-lg': meta.user.profile_image_shape === 'Square', 'rounded-full': meta.user.profile_image_shape !== 'Square' }]} />
        </AppLink>

        <div class="flex flex-col gap-1">
            <div class="leading-none flex items-center gap-1">
                <AppLink title={`View Profile on ${HostLabelMap[host]}`} class="font-semibold  underline-transparent hover:underline-heading underline-offset-2 text-heading underline transition-colors" href={`${host}/${meta.user.screen_name}`}>{meta.user.name}</AppLink>

                {meta.user.is_blue_verified || meta.user.verified ? <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18">
                    <path class:list={[{ 'fill-twitter-gold': meta.user.verified_type === 'Business', 'fill-twitter-gray': meta.user.verified_type === 'Government', 'fill-twitter-blue': !['Business', 'Government'].includes(meta.user.verified_type) }]} d="M22.25 12c0-1.43-.88-2.67-2.19-3.19.46-1.39.1-2.9-1-3.8-1.09-.9-2.61-1.06-3.8-.46C14.67 3.23 13.43 2.35 12 2.35s-2.67.88-3.19 2.19c-1.39-.46-2.9-.1-3.8 1-1 1.09-1.06 2.61-.46 3.8C3.23 9.93 2.35 11.17 2.35 12.6s.88 2.67 2.19 3.19c-.46 1.39-.1 2.9 1 3.8 1.09.9 2.61 1.06 3.8.46 1.02 1.32 2.26 2.2 3.69 2.2s2.67-.88 3.19-2.19c1.39.46 2.9.1 3.8-1 1-1.09 1.06-2.61.46-3.8 1.31-.52 2.19-1.76 2.19-3.19z"/>
                  <path class="fill-background" d="M9.9 16.25l-3.3-3.3 1.4-1.4 1.9 1.9 6.3-6.3 1.4 1.4z"/>
                </svg> : null}
            </div>

            <div class="flex gap-1 items-center leading-none">
                <AppLink title={`View Profile on ${HostLabelMap[host]}`} href={`${host}/${meta.user.screen_name}`} class="text-content/70 text-sm">
                    @{meta.user.screen_name}
                </AppLink>

                &middot;

                <AppLink class="font-semibold text-twitter-blue text-sm underline-transparent hover:underline-twitter-blue underline-offset-2 underline transition-colors" href={`https://x.com/intent/follow?screen_name=${meta.user.screen_name}`}>
                    Follow
                </AppLink>
            </div>
        </div>
    </div>

    <p class="leading-snug whitespace-pre-wrap text-lg dark:text-heading">
        {meta.text}
    </p>

    <div class="flex items-center justify-between text-sm text-content/70">
        <div class="flex gap-1 items-center leading-none">
            <span>
                {new Date(meta.created_at).toLocaleString('en-US', {
                hour: '2-digit',
                minute: '2-digit'
                })}
            </span>

            &middot;

            <span>
                {new Date(meta.created_at).toLocaleString('en-US', {
                day: 'numeric',
                month: 'short',
                year: 'numeric'
                })}
            </span>
        </div>
    </div>

    <div class="h-px w-full border border-separator/50"></div>

    <div>
        <div>
            <Heart class="size-4 text-twitter-red"></Heart>
        </div>
    </div>

    <AppLink href={`${host}/${meta.user.screen_name}/status/${meta.id_str}`} class="grid place-items-center hover:bg-twitter-blue/10 transition-colors text-twitter-blue border border-separator text-sm font-semibold rounded-full py-1">
        Read {numberFormatter.format(meta.conversation_count)} replies
    </AppLink>
</div>
