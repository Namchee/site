---
import Heart from '@/components/astro/icons/Heart.astro';

import type { Tweet } from '@/types/tweet';

import AppLink from '@/components/astro/ui/AppLink.astro';
import Reply from '@/components/astro/icons/Reply.astro';
import Chain from '@/components/astro/icons/Chain.astro';
import Check from '@/components/astro/icons/Check.astro';
import X from '@/components/astro/icons/X.astro';
import Nitter from '@/components/astro/icons/Nitter.astro';
import Play from '@/components/astro/icons/Play.astro';
import Info from '@/components/astro/icons/Info.astro';
import QuotedCuit from './QuotedCuit.astro';

interface Props {
  id: string;
  host?: 'https://x.com' | 'https://nitter.net' | 'https://xcancel.com';
}

const { id, host = 'https://x.com' } = Astro.props;

const HostLabelMap = {
  'https://x.com': 'X',
  'https://nitter.net': 'Nitter',
  'https://xcancel.com': 'XCancel',
};
const HostIconMap = {
  'https://x.com': X,
  'https://nitter.net': Nitter,
  'https://xcancel.com': Nitter,
};

const url = new URL('/tweet-result', 'https://cdn.syndication.twimg.com/');
url.searchParams.set('id', id);
url.searchParams.set('token', 'x');

const result = await fetch(url);
const meta = (await result.json()) as Tweet;

const numberFormatter = new Intl.NumberFormat('en-US', {
  style: 'decimal',
  notation: 'compact',
  compactDisplay: 'short',
  minimumFractionDigits: 0,
  maximumFractionDigits: 1,
});

const regex = /https:\/\/t.co\/.+$/;

const isLimited = regex.test(meta.text);

if (isLimited) {
  meta.text = meta.text.replace(regex, '').trim();
}

const Icon = HostIconMap[host];

const videoUrl = meta.video?.variants
  .filter(variant => variant.type === 'video/mp4')
  .sort((a, b) => {
    const widthA = Number(/\/vid\/[^/]+\/(\d+)x\d+/.exec(a.src)?.[1] ?? 0);
    const widthB = Number(/\/vid\/[^/]+\/(\d+)x\d+/.exec(b.src)?.[1] ?? 0);
    return widthB - widthA;
  })[0]?.src;
---

<div class='relative flex flex-col mx-auto rounded-lg border border-separator w-full max-w-[550px] p-4'>
  <div class='flex items-center gap-2 mb-3'>
    <AppLink
      title={`View Profile on ${HostLabelMap[host]}`}
      href={`${host}/${meta.user.screen_name}`}
      class='shrink-0'
    >
      <img
        src={meta.user.profile_image_url_https}
        class:list={[
          'hover:brightness-90 transition-all',
          {
            'rounded-lg': meta.user.profile_image_shape === 'Square',
            'rounded-full': meta.user.profile_image_shape !== 'Square',
          },
        ]}
      />
    </AppLink>

    <div class='flex flex-col gap-1'>
      <div class='leading-none flex items-center gap-1'>
        <AppLink
          title={`View Profile on ${HostLabelMap[host]}`}
          class='font-semibold underline-transparent hover:underline-heading underline-offset-2 text-heading underline transition-colors'
          href={`${host}/${meta.user.screen_name}`}
          >{meta.user.name}</AppLink
        >

        {
          (meta.user.is_blue_verified || meta.user.verified) && (
            <svg
              xmlns='http://www.w3.org/2000/svg'
              viewBox='0 0 24 24'
              width='18'
              height='18'
              class='shrink-0'
            >
              <path
                class:list={[
                  {
                    'fill-twitter-gold': meta.user.verified_type === 'Business',
                    'fill-twitter-gray': meta.user.verified_type === 'Government',
                    'fill-twitter-blue': !['Business', 'Government'].includes(meta.user.verified_type),
                  },
                ]}
                d='M22.25 12c0-1.43-.88-2.67-2.19-3.19.46-1.39.1-2.9-1-3.8-1.09-.9-2.61-1.06-3.8-.46C14.67 3.23 13.43 2.35 12 2.35s-2.67.88-3.19 2.19c-1.39-.46-2.9-.1-3.8 1-1 1.09-1.06 2.61-.46 3.8C3.23 9.93 2.35 11.17 2.35 12.6s.88 2.67 2.19 3.19c-.46 1.39-.1 2.9 1 3.8 1.09.9 2.61 1.06 3.8.46 1.02 1.32 2.26 2.2 3.69 2.2s2.67-.88 3.19-2.19c1.39.46 2.9.1 3.8-1 1-1.09 1.06-2.61.46-3.8 1.31-.52 2.19-1.76 2.19-3.19z'
              />
              <path
                class='fill-background'
                d='M9.9 16.25l-3.3-3.3 1.4-1.4 1.9 1.9 6.3-6.3 1.4 1.4z'
              />
            </svg>
          )
        }
      </div>

      <div class='flex gap-1 items-center leading-none'>
        <AppLink
          title={`View Profile on ${HostLabelMap[host]}`}
          href={`${host}/${meta.user.screen_name}`}
          class='text-content/70 text-sm'
        >
          @{meta.user.screen_name}
        </AppLink>

        &middot;

        <AppLink
          class='font-semibold text-twitter-blue text-sm underline-transparent hover:underline-twitter-blue underline-offset-2 underline transition-colors'
          href={`https://x.com/intent/follow?screen_name=${meta.user.screen_name}`}
        >
          Follow
        </AppLink>
      </div>
    </div>
  </div>

  <p class='leading-snug whitespace-pre-wrap md:text-lg dark:text-heading mb-3'>
    {meta.text}
    {
      isLimited && (
        <>
          <>... </>
          <AppLink
            class='text-twitter-blue underline underline-offset-2 underline-transparent hover:underline-twitter-blue transition-colors'
            href={`${host}/${meta.user.screen_name}/status/${meta.id_str}`}
          >
            Show More
          </AppLink>
        </>
      )
    }
  </p>

  {
    meta.photos && meta.photos.length > 0 && (
      <div
        class:list={[
          'grid gap-0.5 overflow-hidden rounded-2xl w-full aspect-[16/9] mb-3',
          {
            'grid-cols-1': meta.photos.length === 1,
            'grid-cols-2': meta.photos.length === 2,
            'grid-cols-2 grid-rows-2': meta.photos.length >= 3,
          },
        ]}
      >
        {meta.photos.slice(0, 4).map((p, i) => (
          <AppLink
            class:list={[
              {
                'row-span-2': meta.photos?.length === 3 && i === 0,
              },
            ]}
            href={`https://x.com/${meta.user.screen_name}/status/${meta.id_str}/photo/${i + 1}`}
          >
            <img
              src={p.url}
              class='h-full w-full object-cover'
            />
          </AppLink>
        ))}
      </div>
    )
  }

  {
    meta.video && (
      <div class='relative grid place-items-center'>
        <video
          src={videoUrl}
          poster={meta.video.poster}
          referrerpolicy='no-referrer'
          class='w-full mb-[6px] rounded-2xl bg-black col-start-1 row-start-1'
          style={`aspect-ratio: ${meta.video.aspectRatio[0]} / ${meta.video.aspectRatio[1]}`}
        />

        <button class='size-16 col-start-1 row-start-1 z-10 bg-twitter-blue rounded-full border-4 grid place-items-center border-white hover:brightness-90 transition-all cursor-pointer play__button'>
          <Play class='size-8 fill-white stroke-white' />
        </button>

        {host === 'https://x.com' && (
          <AppLink
            class='absolute z-10 top-4 right-4 bg-black/25 hover:brightness-105 transition-all backdrop-blur-sm text-sm text-white py-2 px-4 font-semibold rounded-full text-sm'
            href={`${host}/${meta.user.screen_name}/status/${meta.id_str}`}
          >
            Watch on X
          </AppLink>
        )}
      </div>
    )
  }

  {
    meta.quoted_tweet && (
      <QuotedCuit
        tweet={meta.quoted_tweet}
        host={host}
      />
    )
  }

  <div class='flex items-center justify-between text-sm text-content/70 mb-[6px]'>
    <AppLink
      href={`${host}/${meta.user.screen_name}/status/${meta.id_str}`}
      class='underline underline-offset-2 underline-transparent hover:underline-content/70 transition-colors leading-none'
    >
      {
        new Date(meta.created_at).toLocaleString('en-US', {
          hour: '2-digit',
          minute: '2-digit',
        })
      }
      &#8239;&middot;&#8239;
      {
        new Date(meta.created_at).toLocaleString('en-US', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
        })
      }
    </AppLink>

    {
      host === 'https://x.com' && (
        <AppLink
          href='https://help.x.com/en/x-for-websites-ads-info-and-privacy'
          class='group hover:bg-twitter-blue/10 p-[6px] rounded-full transition-colors'
        >
          <Info class='size-4 text-content/70 group-hover:text-twitter-blue transition-colors' />
        </AppLink>
      )
    }
  </div>

  <div class='h-px w-full border border-separator/50 mb-[6px]'></div>

  <div class='mb-[6px]'>
    <div class='flex items-center gap-2'>
      <AppLink
        title='Like this Tweet'
        class='flex items-center group gap-0.5'
        href={`https://x.com/intent/like?tweet_id=${meta.id_str}`}
      >
        <div class='p-[6px] rounded-full bg-transparent group-hover:bg-twitter-red/10 transition-colors'>
          <Heart class='size-4 text-twitter-red' />
        </div>
        <span
          class='font-semibold text-sm underline underline-offset-2 underline-transparent group-hover:underline-twitter-red transition-colors group-hover:text-twitter-red'
          >{numberFormatter.format(meta.favorite_count)}</span
        >
      </AppLink>

      <AppLink
        title='Reply this Tweet'
        class='flex items-center group gap-0.5'
        href={`https://x.com/intent/tweet?in_reply_to=${meta.id_str}`}
      >
        <div class='p-[6px] rounded-full bg-transparent group-hover:bg-twitter-blue/10 transition-colors'>
          <Reply class='size-4 fill-twitter-blue stroke-twitter-blue' />
        </div>
        <span
          class='font-semibold text-sm underline underline-offset-2 underline-transparent group-hover:underline-twitter-blue transition-colors group-hover:text-twitter-blue'
          >Reply</span
        >
      </AppLink>

      <button
        class='flex items-center group gap-0.5 copy__tweet cursor-pointer disabled:cursor-default'
        data-tweet={`${host}/${meta.user.screen_name}/status/${meta.id_str}`}
      >
        <div
          class='p-[6px] rounded-full bg-transparent group-hover:bg-twitter-green/10 !group-disabled:bg-transparent transition-colors'
        >
          <Chain
            class='size-4 stroke-content group-hover:stroke-twitter-green transition-colors chain !group-disabled:stroke-content'
          />
          <Check class='size-4 hidden check' />
        </div>

        <span
          class='font-semibold text-sm underline underline-offset-2 underline-transparent group-hover:underline-twitter-green transition-colors group-hover:text-twitter-green !group-disabled:text-content !group-disabled:underline-transparent'
          >Copy Link</span
        >
      </button>
    </div>
  </div>

  <AppLink
    href={`${host}/${meta.user.screen_name}/status/${meta.id_str}`}
    class='grid place-items-center hover:bg-twitter-blue/10 transition-colors text-twitter-blue border border-separator text-sm font-semibold rounded-full py-1'
  >
    Read {numberFormatter.format(meta.conversation_count)} replies
  </AppLink>

  <AppLink
    href={`${host}/${meta.user.screen_name}/status/${meta.id_str}`}
    class='top-4 right-4 absolute stroke-content transition-colors hover:stroke-heading'
  >
    <Icon class='size-5' />
  </AppLink>
</div>

<script>
  const buttons = document.querySelectorAll('.copy__tweet');
  const playButtons = document.querySelectorAll('.play__button');

  for (const b of buttons) {
    const button = b as HTMLButtonElement;

    button.addEventListener('click', async () => {
      const tweet = button.dataset.tweet;
      const chain = button.querySelector('.chain');
      const check = button.querySelector('.check');
      const text = button.querySelector('span');

      if (!navigator.clipboard || !tweet || !chain || !check || !text) {
        return;
      }

      await navigator.clipboard.writeText(tweet);

      text.textContent = 'Copied!';
      chain.classList.toggle('hidden');
      check.classList.toggle('hidden');
      button.disabled = true;

      setTimeout(() => {
        text.textContent = 'Copy Link';
        chain.classList.toggle('hidden');
        check.classList.toggle('hidden');
        button.disabled = false;
      }, 2_500);
    });

    for (const pb of playButtons) {
      pb.addEventListener('click', () => {
        const playButton = pb as HTMLButtonElement;
        const par = pb.parentElement;
        if (!par) {
          return;
        }

        const vid = par.querySelector('video');
        const watchOn = par.querySelector('a');
        if (!vid) {
          return;
        }

        vid.setAttribute('controls', 'true');
        vid.play();

        playButton.style.opacity = '0';
        playButton.style.pointerEvents = 'none';

        if (watchOn) {
          watchOn.style.opacity = '0';
          watchOn.style.pointerEvents = 'none';

          vid.addEventListener('pause', () => {
            if (!vid.ended) {
              watchOn.textContent = 'Continue watching on X';
              watchOn.style.opacity = '1';
              watchOn.style.pointerEvents = 'auto';
            }
          });

          vid.addEventListener('play', () => {
            watchOn.style.opacity = '0';
            watchOn.style.pointerEvents = 'none';
          });
        }
      });
    }
  }
</script>
