---
interface Tweet {
  id_str: string;
  text: string;
  user: {
    name: string;
    screen_name: string;
    id: string;
    is_blue_verified: boolean;
    verified: string;
    profile_image_url_https: string;
  };
  conversation_count: number;
  news_action_type: string;
}

interface Props {
  id: string;
  host?: 'https://www.x.com' | 'https://nitter.net';
}

const { id, host = 'https://nitter.net' } = Astro.props;

const url = new URL('/tweet-result', 'https://cdn.syndication.twimg.com/');
url.searchParams.set('id', id);
url.searchParams.set('token', 'x');

const result = await fetch(url);
const meta = await result.json() as Tweet;

// lacking like info, lacking view,
console.log(meta);
---

<div class="flex flex-col mx-auto rounded-md border border-separator w-full max-w-[550px] p-4">
    <div class="flex items-center gap-4">
        <img src={meta.user.profile_image_url_https} class="rounded-full" />

        <div>
            <p class="font-bold">{meta.user.name}</p>
            <p class="text-content">
                {meta.user.screen_name}
            </p>
        </div>
    </div>
</div>
