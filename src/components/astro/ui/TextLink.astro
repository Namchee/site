---
import type { HTMLAttributes } from 'astro/types';

import ExternalLink from '~icons/lucide/external-link';

import AppLink from '@/components/astro/ui/AppLink.astro';

type Props = HTMLAttributes<'a'>;

const { class: className, ...props } = Astro.props;
let origin = '';

try {
  origin = new URL(props.href ?? '').origin;
} catch {
  // do nothing
}

const baseClass = `:uno:
  text-heading/80
  font-medium
  cursor-pointer
  decoration-heading
  decoration-opacity-20
  transition-colors
  hover:text-heading
  focus:text-heading
  hover:decoration-opacity-100
  focus:decoration-opacity-100
  underline
  underline-offset-4`;
const externalClass = 'inline-flex items-center';

const classes = [baseClass];
if (origin) {
  classes.push(externalClass);
}

classes.push(className as string);
---

<AppLink
  class:list={classes}
  {...props}
><slot />{origin && <ExternalLink class=":uno: ml-1 size-[14px]" />}</AppLink>
