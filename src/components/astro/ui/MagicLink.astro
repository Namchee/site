---
import type { HTMLAttributes } from 'astro/types';

import AppLink from '@/components/astro/ui/AppLink.astro';

type Props = HTMLAttributes<'a'>;

const { class: className, ...props } = Astro.props;
let origin = '';

try {
  origin = new URL(props.href ?? '').origin;
} catch {
  // do nothing
}

const img = `https://www.google.com/s2/favicons?sz=12&domain=${origin}`;

const baseClass = `:uno:
  inline-flex items-center
  bg-surface-2 hover:bg-surface-3
  transition-colors
  rounded-full
  pr-2`;
---

<AppLink
  class:list={[baseClass, className]}
  {...props}
><img src={img} className=":uno: mr-2 rounded-full size-4" /><slot /></AppLink>
